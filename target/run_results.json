ilm_id\n    left join category on film_category.category_id = category.category_id\n    group by film.film_id\n)\nselect film.dbt_scd_id as film_pk,\n    film.film_id,\n    initcap(film.title) as title,\n    film.description,\n    film.release_year,\n    language.name as language,\n    film.rental_duration,\n    film.rental_rate,\n    film.length as duration_in_minutes,\n    case\n        when film.length < 60 then 'Short'\n        when film.length >= 60 and film.length < 120 then 'Medium'\n        else 'Long'\n    end as duration_category,\n    film.replacement_cost,\n    film.rating,\n    film.special_features,\n    film.fulltext,\n    coalesce(aggregated_category.categories, '[]'::jsonb) as categories,\n    film.dbt_valid_from as valid_from,\n    coalesce(film.dbt_valid_to, '9999-12-31'::timestamp) as valid_to\nfrom \"dbt_practice\".\"public\".\"snap_films\" as film\nleft join language on film.language_id = language.language_id\nleft join aggregated_category on film.film_id = aggregated_category.film_id\n\n", "relation_name": "\"dbt_practice\".\"public\".\"dim_films\"", "batch_results": null, "overload_results": null}], "elapsed_time": 1.1929783821105957, "args": {"use_catalogs_v2": false, "require_generic_test_arguments_property": true, "require_all_warnings_handled_by_warn_error": true, "exclude_resource_types": [], "macro_debugging": false, "exclude": [], "require_resource_names_without_spaces": true, "log_file_max_bytes": 10485760, "log_level_file": "debug", "empty": false, "hints_enabled": true, "require_batched_execution_for_custom_microbatch_strategy": true, "state_modified_compare_vars": false, "populate_cache": true, "v2_parser": "dbt-core-experimental-parser parse", "require_ref_searches_node_package_before_root": false, "printer_width": 80, "latest_version_pointer_enabled_by_default": false, "require_explicit_package_overrides_for_builtin_materializations": true, "source_freshness_run_project_hooks": true, "validate_macro_args": true, "require_source_a