    from "dbt_practice"."public"."customer"
),
raw_inventory as (
    select *
    from "dbt_practice"."public"."inventory"
),
raw_films as (
    select *
    from "dbt_practice"."public"."film"
),
raw_stores as (
    select *
    from "dbt_practice"."public"."store"
)
